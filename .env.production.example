# Production settings for pachwomen.com (Hostinger).
# On the server:  cp .env.production.example .env  &&  php artisan key:generate
# Then fill in DB_DATABASE, DB_USERNAME and DB_PASSWORD from hPanel → Databases.
# Shop details, shipping and Razorpay keys are set in /admin → Site settings.

APP_NAME="PACH WOMEN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pachwomen.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no queue worker, so jobs run immediately.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Password-reset emails. Until SMTP is set up they go to the log file.
# For Hostinger email: MAIL_MAILER=smtp, MAIL_HOST=smtp.hostinger.com, MAIL_PORT=465,
# MAIL_SCHEME=smtps, MAIL_USERNAME=hello@pachwomen.com, MAIL_PASSWORD=(mailbox password)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@pachwomen.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
